(function(outputs, steps, params, stepResult, assertEqual) {
    var requestType = 'health_inpection';
    var priority = 'low';

    // Map table value to DT condition value
    var dtRequestType = 'general_health';

    var dtApi = new sn_dt.DecisionTableAPI();
    var dtInputs = { u_request_type: dtRequestType, u_priority: priority };
    var result = dtApi.getDecision('9f5da86ac32647101ff35d02b4013121', dtInputs);

    var groupName = 'Health Support';
    if (result &amp;&amp; result.length &gt; 0 &amp;&amp; result[0].u_assignment_group) {
        var groupValue = result[0].u_assignment_group.toString();
        var grp = new GlideRecord('sys_user_group');
        if (grp.get(groupValue)) {
            groupName = grp.getValue('name');
        } else {
            groupName = groupValue;
        }
    }

    assertEqual({ name: 'Assignment group should be Health Support', shouldbe: 'Health Support', value: groupName });
    stepResult.setOutputMessage('Assignment for health_inpection+low = ' + groupName);
})(outputs, steps, params, stepResult, assertEqual);
