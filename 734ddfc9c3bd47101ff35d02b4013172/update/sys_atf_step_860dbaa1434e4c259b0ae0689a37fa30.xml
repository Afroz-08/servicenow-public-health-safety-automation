(function(outputs, steps, params, stepResult, assertEqual) {
    var requestType = 'appointment';
    var urgency = 'medium';

    var dtApi = new sn_dt.DecisionTableAPI();
    var dtInputs = { u_request_type: requestType, u_urgency: urgency };
    var result = dtApi.getDecision('bf5a9df0c3ce83901ff35d02b401317a', dtInputs);

    var dtPriority = (result &amp;&amp; result.length &gt; 0 &amp;&amp; result[0].u_priority) ? result[0].u_priority.toString() : '';
    var finalPriority;
    if (dtPriority &amp;&amp; dtPriority !== 'medium') {
        finalPriority = dtPriority;
    } else {
        finalPriority = urgency || 'medium';
    }

    assertEqual({ name: 'Priority should be medium', shouldbe: 'medium', value: finalPriority });
    outputs.priority = finalPriority;
    stepResult.setOutputMessage('Priority for appointment+medium = ' + finalPriority);
})(outputs, steps, params, stepResult, assertEqual);
        </value>
